{
  "permissions": {
    "allow": [
      "Bash(make:*)", "Bash(pnpm:*)", "Bash(uv:*)", "Bash(npx:*)",
      "Bash(docker compose:*)", "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git fetch:*)", "Bash(git merge origin/main)", "Bash(git worktree list)",
      "Bash(git push -u origin ticket-*)", "Bash(git push origin ticket-*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr diff:*)", "Bash(gh pr comment:*)",
      "Bash(gh issue:*)"
