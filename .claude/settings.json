      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin main:*)",
      "Bash(gh pr merge:*)", "Bash(gh repo delete:*)", "Bash(gh secret:*)",
      "Bash(rm -rf:*)", "Bash(sudo:*)", "Bash(curl:*)", "Bash(wget:*)",
      "Bash(kubectl:*)", "Bash(terraform apply:*)", "Bash(aws:*)"
